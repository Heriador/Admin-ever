# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml). Omit to fall back to SQLite.
DATABASE_URL=postgres://admin_ever:admin_ever@localhost:5432/admin_ever

# Origins of the custom admin UI during development, e.g. a Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
